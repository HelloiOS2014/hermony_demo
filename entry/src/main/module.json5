{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:entry_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    // [v4-1] Hypium 测试 testRunner 入口
    //   debug 包测试制品由 hvigorw test --mode debug 编译后注入 testRunner，
    //   testRunner.name = OhosTestRunner（实现见 entry/src/test/OhosTestRunner.ets）
    //   srcPath 指向 ohosTest 测试根（hvigor 默认按 src/test 找；此处保留显式声明便于日后切目录）
    "testRunner": {
      "name": "OhosTestRunner",
      "srcPath": "ohosTest"
    },
    "requestPermissions": [
      {
        "name": "ohos.permission.READ_CONTACTS",
        "reason": "$string:perm_contacts_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:perm_camera_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      },
      // v2-multidevice：分布式数据同步权限
      // distributedDataObject + 自由流转 都需要此权限；DEVICE 间软总线通信靠它放行
      {
        "name": "ohos.permission.DISTRIBUTED_DATASYNC",
        "reason": "$string:perm_distributed_reason",
        "usedScene": {
          "abilities": ["EntryAbility"],
          "when": "inuse"
        }
      }
    ]
  }
}
